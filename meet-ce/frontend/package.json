{
	"name": "@openvidu-meet/frontend",
	"version": "3.8.0",
	"scripts": {
		"clean": "rm -rf node_modules dist test-results .angular",
		"assets:livekit": "node scripts/copy-livekit-assets.mjs",
		"postinstall": "node scripts/copy-livekit-assets.mjs",
		"dev": "pnpm run assets:livekit && pnpm exec ng build --configuration development --watch",
		"build": "func() { pnpm run assets:livekit && pnpm exec ng build --configuration production --base-href=\"${1:-/}\"; }; func",
		"lib:serve": "ng build shared-meet-components --watch",
		"lib:build": "ng build shared-meet-components --configuration production",
		"lib:pack": "cd dist/shared-meet-components && pnpm pack",
		"test:unit:lib": "ng test shared-meet-components --watch=false --browsers=ChromeHeadlessCI",
		"e2e:playwright:all": "pnpm run e2e:playwright:spa && pnpm run e2e:playwright:wc",
		"e2e:playwright:spa": "playwright test --project=spa",
		"test:types:e2e": "tsc --noEmit -p tsconfig.test.json",
		"e2e:playwright:wc": "playwright test --config=webcomponent/playwright.config.ts --project=webcomponent",
		"lint": "eslint src projects/shared-meet-components/src webcomponent/src webcomponent/tests e2e --max-warnings 0",
		"lint:fix": "eslint src projects/shared-meet-components/src --fix --max-warnings 0",
		"format:code": "prettier --ignore-path ../gitignore . --write"
	},
	"dependencies": {
		"@angular/animations": "22.1.2",
		"@angular/cdk": "22.1.2",
		"@angular/common": "22.1.2",
		"@angular/compiler": "22.1.2",
		"@angular/core": "22.1.2",
		"@angular/forms": "22.1.2",
		"@angular/material": "22.1.2",
		"@angular/platform-browser": "22.1.2",
		"@angular/platform-browser-dynamic": "22.1.2",
		"@angular/router": "22.1.2",
		"@livekit/track-processors": "0.7.2",
		"@openvidu-meet/shared-components": "workspace:*",
		"@openvidu-meet/typings": "workspace:*",
		"core-js": "3.50.0",
		"jwt-decode": "4.0.0",
		"linkify-string": "4.3.3",
		"linkifyjs": "4.3.3",
		"livekit-client": "2.22.0",
		"rxjs": "7.8.2",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@angular-builders/custom-webpack": "22.0.1",
		"@angular-devkit/build-angular": "22.1.4",
		"@angular/cli": "22.1.4",
		"@angular/compiler-cli": "22.1.2",
		"@playwright/test": "1.62.1",
		"@types/jasmine": "5.1.15",
		"@types/node": "24.13.3",
		"@types/pngjs": "6.0.5",
		"@eslint/js": "10.0.1",
		"angular-eslint": "22.1.0",
		"cross-env": "10.1.0",
		"eslint": "10.8.1",
		"eslint-config-prettier": "10.1.8",
		"jasmine": "5.13.0",
		"jasmine-core": "5.6.0",
		"karma": "6.4.4",
		"karma-chrome-launcher": "3.2.0",
		"karma-coverage": "2.2.1",
		"karma-jasmine": "5.1.0",
		"karma-jasmine-html-reporter": "2.2.0",
		"ng-packagr": "22.1.1",
		"prettier": "3.9.6",
		"tslib": "2.6.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.67.0"
	}
}
