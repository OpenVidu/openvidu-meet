{
	"name": "@openvidu-meet/webcomponent",
	"version": "2.0.0",
	"private": true,
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"build:wc:angular": "ng build --configuration=wc",
		"build:wc:post": "node scripts/concat-wc.js && node scripts/deploy-to-backend.js",
		"deploy:backend": "node scripts/deploy-to-backend.js",
		"build:wc:bundle": "pnpm run build:wc:angular && pnpm run build:wc:post",
		"dev": "node scripts/dev.js",
		"test:unit": "jest --forceExit --testPathPatterns \"tests/unit\" --ci",
		"test:types": "tsc --noEmit -p tsconfig.test.json",
		"test:e2e": "playwright test --project=webcomponent"
	},
	"dependencies": {
		"@angular/animations": "22.2.0",
		"@angular/cdk": "22.2.0",
		"@angular/common": "22.2.0",
		"@angular/compiler": "22.2.0",
		"@angular/core": "22.2.0",
		"@angular/elements": "22.2.0",
		"@angular/forms": "22.2.0",
		"@angular/material": "22.2.0",
		"@angular/platform-browser": "22.2.0",
		"@angular/router": "22.2.0",
		"@livekit/track-processors": "0.8.1",
		"@openvidu-meet/shared-components": "workspace:*",
		"@openvidu-meet/typings": "workspace:*",
		"jwt-decode": "4.0.0",
		"livekit-client": "2.22.3",
		"rxjs": "7.8.2",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@angular/build": "22.2.0",
		"@angular/cli": "22.2.0",
		"@angular/compiler-cli": "22.2.0",
		"@playwright/test": "1.63.0",
		"@types/jest": "30.0.0",
		"@types/pngjs": "6.0.5",
		"jest": "30.5.2",
		"jest-environment-jsdom": "30.5.2",
		"pixelmatch": "7.2.0",
		"pngjs": "7.0.0",
		"ts-jest": "29.4.13",
		"ts-jest-resolver": "2.0.1",
		"typescript": "6.0.3"
	}
}
